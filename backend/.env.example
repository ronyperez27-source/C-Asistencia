# Cadena de conexión SQLAlchemy (SQL Server o SQLite).
# SQL Server: mssql+pyodbc://usuario:clave@localhost/AsistenciaDB?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=sqlite:///./sql_app.db

# Clave para firmar los tokens JWT. Cambiar obligatoriamente en producción.
SECRET_KEY=cambiar-esta-clave-en-produccion

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
